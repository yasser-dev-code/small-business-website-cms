# Server
PORT=5000
NODE_ENV=development

# Database
# Leave MONGO_URI empty to automatically use an in-memory MongoDB (great for demos/tests).
# For a persistent local database use: mongodb://127.0.0.1:27017/maison_gourmet_cms
# For MongoDB Atlas use your connection string.
MONGO_URI=

# Auth / security
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Demo admin (created by the seed script) - change these before deploying!
DEMO_ADMIN_NAME=Maison Gourmet Owner
DEMO_ADMIN_EMAIL=admin@maisongourmet.com
DEMO_ADMIN_PASSWORD=Admin123!
